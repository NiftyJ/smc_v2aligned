+def _htf_zones(df, s, c, closes_t):
+    """The order blocks and FVGs on s.HTF_ZONE_TFS, each with the candle it is known at and the first
+    candle closing beyond its far edge (it counts in between)."""
+    hz = pois(df, tfs=s.HTF_ZONE_TFS, swing_n=s.SWING_N)
+    hz = hz[hz["type"].str.endswith(("_ob", "_fvg"))].reset_index(drop=True)
+    n = len(c)
+    zdir = hz["dir"].to_numpy()
+    since = np.searchsorted(closes_t, hz["known"].to_numpy(), side="left")
+    far = np.where(zdir == 1, hz["bottom"], hz["top"]).astype(float)
+    until = np.full(len(hz), n)
+    for d in (1, -1):
+        k = zdir == d
+        until[k] = first_beyond(c, np.minimum(since[k], n - 1), far[k], d)
+    return dict(key=list(zip(hz["tf"], hz["type"], hz["formed"])), dir=zdir, top=hz["top"].to_numpy(float),
+                bottom=hz["bottom"].to_numpy(float), since=since, until=until)
+
+
+def _inside(nest, d, t, top, bottom, key):
+    """Does the zone [bottom, top], touched at candle t, sit in a higher-timeframe zone of direction d that
+    counts at t (overlapping it; not the zone itself)?"""
+    ok = (nest["dir"] == d) & (nest["since"] <= t) & (nest["until"] > t) & (nest["bottom"] <= top) & (nest["top"] >= bottom)
+    return any(nest["key"][j] != key for j in np.flatnonzero(ok))
+
